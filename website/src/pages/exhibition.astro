---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const artworks = (await getCollection('artworks')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

// Hero slideshow — a spread of up to 8 works across the collection.
const withImages = artworks.filter((a) => a.data.image);
const HERO_MAX = 8;
const heroStep = Math.max(1, Math.floor(withImages.length / HERO_MAX));
const heroSlides = withImages.filter((_, i) => i % heroStep === 0).slice(0, HERO_MAX);

const sponsors = [
  { name: 'The Tallowed Truth', url: 'https://thetallowedtruth.com/', logo: '/images/logos/sponsor-tallowed-truth.png' },
  { name: 'St Joseph Realty', url: 'http://www.stjosephrealty.ca', logo: '/images/logos/sponsor-st-joseph-realty.png' },
  { name: 'Valley Autoglass', url: 'https://valleyauto.ca/', logo: '/images/logos/sponsor-valley-autoglass.png' },
];
---
<BaseLayout
  title="2026 Exhibition — The Drama of the Soul"
  description="The Drama of the Soul: a group exhibition by Theopolis exploring the existence, nature, and problems of the Soul, held in Toronto in May 2026. Explore the full archive of works."
  ogImage="/images/exhibition/drama-of-the-soul-banner.png"
  fullWidth
>
  <!-- ── Full-screen gallery hero — a slideshow of the exhibition works ── -->
  <section class="ex-hero" aria-label="The Drama of the Soul — 2026 exhibition">
    <div class="ex-slides" id="ex-slides" aria-hidden="true">
      {heroSlides.map((art, i) => (
        <img
          class:list={['ex-slide', { 'is-active': i === 0 }]}
          src={art.data.image}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
      ))}
    </div>
    <div class="ex-hero-scrim"></div>
    <div class="ex-hero-overlay">
      <p class="ex-hero-eyebrow">2026 Exhibition</p>
      <h1 class="ex-hero-title">The Drama of the Soul</h1>
      <p class="ex-hero-sub">A group exhibition of Catholic art &middot; Toronto, May 2026</p>
      <a href="/archive" class="ex-hero-cue">Explore the archive <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <!-- Intro: Dante epigraph + the record of when it was shown -->
  <section class="mx-auto max-w-3xl px-6 pt-16 lg:pt-20 pb-2 text-center">
    <blockquote class="mx-auto max-w-2xl text-xl md:text-2xl italic leading-snug text-[var(--thp-muted-foreground)]">
      &ldquo;Before me were no things created except eternal ones, and I endure eternal.&rdquo;
      <footer class="mt-2 text-base not-italic text-[var(--thp-gold)]">&mdash; Dante, <em>The Inferno</em>, Canto III</footer>
    </blockquote>
    <div class="gold-flourish"><span>&#9670;</span></div>
    <p class="text-[var(--thp-muted-foreground)]">Presented May 2026 &middot; 183 Queen St E, Toronto</p>
  </section>

  <!-- Theme / concept — standard body measure, matches "Our Story" on About -->
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-16 lg:pb-20">
    <div class="space-y-6 text-[1.15rem] leading-[1.75] text-[var(--thp-foreground)]">
      <p>
        The Soul has long been depicted in art and literature as the protagonist of a drama
        that stretches beyond life, death, and time.
      </p>
      <p>
        In the introduction to her 1949 translation of <em>The Divine Comedy</em>, Dorothy L.
        Sayers writes that Dante’s masterwork is &ldquo;precisely the drama of the soul’s
        choice.&rdquo; It is not a fairy story but a great Christian allegory, deriving its
        power from the terror and splendour of the Christian revelation. Creative explorations
        such as Dante’s reveal that this drama of eternal consequence lies at the heart of
        life’s greatest questions &mdash; good and evil, love, suffering, and faith. Yet in an
        age marked by materialism, consumerism, and omnipresent technology, the reality of the
        Soul is easy to overlook, or to forget entirely.
      </p>
      <p>
        <strong class="text-[var(--thp-foreground)]">The Drama of the Soul</strong> was a group
        exhibition organized by Theopolis, a collective of Catholic artists. It invited works
        that reflect on the existence, nature, and problems of the Soul. While informed by the
        Catholic intellectual and artistic tradition, the works need not be explicitly
        religious &mdash; each engages the theme with seriousness and depth, attentive to the
        gravity of the subject matter.
      </p>
    </div>
  </section>

  <!-- Sponsors -->
  <section class="mx-auto max-w-5xl px-6 pb-20 text-center">
    <p class="eyebrow">Our Sponsors</p>
    <div class="gold-flourish"><span>&#9670;</span></div>
    <div class="sponsors mt-8">
      {sponsors.map((s) => (
        <a href={s.url} target="_blank" rel="noopener" class="sponsor-cell" aria-label={s.name} title={s.name}>
          <img src={s.logo} alt={s.name} loading="lazy" class="sponsor-logo" />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Full-screen gallery hero ─────────────────────────────────────
     A crossfading slideshow of the exhibition works fills the viewport,
     darkened by a navy scrim, with the title + "explore" cue laid over it. */
  .ex-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: var(--thp-navy);
  }
  .ex-slides { position: absolute; inset: 0; }
  .ex-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .ex-slide.is-active { opacity: 1; }
  .ex-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(15, 55, 82, 0.55), rgba(15, 55, 82, 0.68));
  }
  .ex-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    color: #f9f4e9;
  }
  .ex-hero-eyebrow {
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--thp-marigold);
    margin-bottom: 1.1rem;
  }
  .ex-hero-title {
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    font-size: clamp(2.75rem, 7vw, 6rem);
    color: #f9f4e9;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }
  .ex-hero-sub {
    margin-top: 1.35rem;
    font-family: var(--font-body);
    font-size: 1.05rem;
    letter-spacing: 0.01em;
    color: rgba(249, 244, 233, 0.85);
  }
  .ex-hero-cue {
    margin-top: 2.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.76rem;
    color: #f9f4e9;
    text-decoration: none;
    border: 1px solid rgba(249, 244, 233, 0.5);
    border-radius: 9999px;
    padding: 0.75rem 1.5rem;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .ex-hero-cue:hover { background: rgba(249, 244, 233, 0.12); border-color: #f9f4e9; }
  .ex-hero-cue span { transition: transform 0.2s ease; }
  .ex-hero-cue:hover span { transform: translateX(3px); }

  /* Sponsor logos — equal columns so the middle logo centres under the heading. */
  .sponsors {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 2rem;
    align-items: center;
    justify-items: center;
  }
  @media (min-width: 640px) { .sponsors { grid-template-columns: repeat(3, 1fr); } }
  .sponsor-cell { display: flex; align-items: center; justify-content: center; }
  .sponsor-logo {
    height: 6.5rem;
    width: auto;
    object-fit: contain;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }
  @media (min-width: 640px) { .sponsor-logo { height: 7.5rem; } }
  .sponsor-logo:hover { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .ex-slide { transition: none; }
  }
</style>

<script>
  // Auto-advancing crossfade for the hero gallery.
  const slides = Array.from(document.querySelectorAll('#ex-slides .ex-slide'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (slides.length > 1 && !reduce) {
    let idx = 0;
    window.setInterval(() => {
      slides[idx].classList.remove('is-active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('is-active');
    }, 3400);
  }
</script>
