---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const catholicArt = [
  'Are original and imaginative',
  'Offer new perspective',
  'Contemplate the transcendentals',
  'Deal with substance and content',
  'Engage the complexity of sin and suffering',
  'Celebrate the dignity of mankind',
  'Much more!',
];

const founders = [
  {
    name: "Eden O'Brien",
    role: 'Co-Founder and Executive Director',
    image: '/images/about/eden-obrien.jpg',
    bio: 'Eden holds an MLitt in Theological Aesthetics from the University of St Andrews and a B.A. in Philosophy from Our Lady Seat of Wisdom College. Her work explores the intersection of art and truth, with research in 19th- & 20th-century Aestheticism, Religion & Literature, and Tolkien’s poetics. Eden has contributed to academic projects including co-editing a volume for the Edinburgh Journal of Inkling Studies and serves as associate editor for Transpositions. Passionate about the dialogue between faith and the arts, she has spoken at numerous events and currently works in Business Development across North America and Europe.',
    studioUrl: null,
  },
  {
    name: 'Monica Sifert',
    role: 'Co-Founder',
    image: '/images/about/monica-sifert.jpg',
    bio: 'Monica studied sacred art, fine art, and iconography in Florence, Italy; Crete, Greece; and Phoenix, Arizona. She also holds a B.A. in Philosophy and Literature from Our Lady Seat of Wisdom College. Inspired by the Italian Masters, the Pre-Raphaelites, the Arts & Crafts Movement, and even “bad art” she seeks to reimagine, Monica creates art that transforms inspiration into beauty. She is passionate about craftsmanship and loves making things from scratch. Alongside her artistic practice, she works as a Corporate Paralegal.',
    studioUrl: 'https://www.iconicstudioart.com',
  },
];

// Wider team — headshots still to come for those with image: null.
const teamMembers = [
  { name: 'Juliana De Martin', role: 'Social Media Director', image: '/images/about/juliana-de-martin.jpg' },
  {
    name: "Samantha O'Brien",
    role: 'Lead Graphic Designer',
    image: '/images/about/samantha-obrien.jpg',
    bio: 'Samantha O’Brien is a Toronto-based Catholic creative specializing in graphic design and hand lettering. She graduated with distinction from OCAD University with a Bachelor of Design. Clarity and functionality guide her work across a variety of media. Her experience includes graphic design for startups and corporate clients, as well as communications work within the Archdiocese of Toronto. She is continually developing new skills and finding ways to apply them to her creative practice. Samantha is also a wife and mother of two and enjoys trying new recipes in her free time.',
  },
  { name: 'Alejandra Mendoza', role: 'Program Coordinator', image: '/images/about/alejandra-mendoza.jpg' },
  {
    name: 'Trevor Anzai',
    role: 'Artist Coordinator',
    image: '/images/about/trevor-anzai.jpg',
    bio: 'Trevor Anzai is a Catholic visual artist and writer based in Ottawa. Working primarily in oils, he explores his creative practice alongside his monthly Substack publication, Build Your Life. Outside his work, Trevor enjoys spending time with his family, playing ball hockey, and gathering around board games.',
  },
  { name: 'Adrian Tadeo', role: 'Videographer', image: '/images/about/adrian-tadeo.jpg' },
];

// Founders first, then the wider team — rendered as one grid (4 on top, 3 below).
const allMembers = [...founders, ...teamMembers];
---
<BaseLayout
  title="About Us"
  description="Theopolis is equipping a rising generation of Catholic artists and creating a space of encounter between the secular and the sacred."
  fullWidth
>
  <!-- Hero banner — the Pantheon dome, with the mission over it (partial height, not full-screen) -->
  <section class="about-hero">
    <img
      class="about-hero-img"
      src="/images/about/pantheon-dome.png"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="about-hero-veil"></div>
    <div class="about-hero-inner mx-auto max-w-6xl px-6">
      <div class="about-hero-content">
        <p class="label section-kicker about-hero-kicker">About</p>
        <h1 class="about-hero-title">The Mission</h1>
        <p class="about-hero-mission">
          Theopolis is equipping a rising generation of Catholic artists and creating a space of
          encounter between the Secular and Sacred.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Story — plain section on cream -->
  <section class="mx-auto max-w-6xl px-6 py-24 lg:py-28">
    <p class="label section-kicker">Our Story</p>
    <hr class="rule mt-4" />
    <div class="mt-8 space-y-6 text-[1.15rem] leading-[1.75] text-[var(--thp-foreground)]">
      <p>
        Theopolis began as conversations between friends passionate about art, culture,
        community and the Catholic tradition. What started as study and reflection in Ontario,
        the U.S.A., U.K., Italy, and Greece evolved into a mission: to revive Catholic art in
        our communities.
      </p>
      <p>
        Our inspiration comes from the story of the Apostle Philip and the Ethiopian Eunuch
        (Acts 8:26&ndash;40): teaching that the Ethiopian was poised for baptism by reading the
        Word that he did not yet understand, this passage inspired our mission to empower
        Catholic artists to create an initial encounter between the sacred and the
        &lsquo;unwitting world&rsquo; so that it might be likewise poised by a beauty that it
        sees and hears without understanding and ask, &ldquo;how can I [understand] unless
        someone instructs me?&rdquo; (Acts 8:31).
      </p>
      <p>
        Through this vision, Theopolis sets out to share the wealth of the Catholic artistic
        tradition with the world: stirring hearts and lifting the gaze heaven-ward.
      </p>
    </div>
  </section>

  <!-- What is Catholic Art — the Cuyp painting sits behind a cream veil -->
  <section class="cathart-band">
    <div class="cathart-overlay">
      <div class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
        <p class="label section-kicker">What is Catholic Art?</p>
        <hr class="rule mt-4" />
        <div class="mt-8 space-y-6 text-[1.15rem] leading-[1.75] text-[var(--thp-foreground)]">
          <p>
            In our use of the term, Catholic art encompasses more than traditional religious
            imagery. It includes any creative expressions&mdash;painting, sculpture, music,
            literature, film, photography, and more&mdash;that are made within the spirit of the
            Faith.
          </p>
          <p>
            We prize creative excellence and welcome a range of themes, styles, and subjects.
          </p>
          <p>
            We value works that:
          </p>
        </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {catholicArt.map((item) => (
          <li class="flex items-start gap-3 rounded-lg border border-[var(--thp-border)] bg-[var(--thp-card)] px-4 py-3">
            <span class="mt-1 text-[var(--thp-gold)]">&#9670;</span>
            <span class="text-[var(--thp-foreground)]">{item}</span>
          </li>
        ))}
      </ul>
      <blockquote class="mt-10 text-2xl italic leading-snug text-[var(--thp-foreground)]">
        &ldquo;Catholic art, in our reckoning, engages the world through imagination, beauty,
        and truth.&rdquo;
      </blockquote>
      </div>
      <p class="cathart-credit">Saint Philip Baptising the Ethiopian Eunuch &mdash; Aelbert Cuyp (public domain)</p>
    </div>
  </section>

  <!-- Meet the Team -->
  <section class="mx-auto max-w-6xl px-6 py-16 lg:py-20">
    <p class="label section-kicker">Meet the Team</p>
    <hr class="rule mt-4" />

    <!-- Team — 4 on top, 3 below (founders first). Hover a profile to reveal their bio. -->
    <div class="mx-auto mt-12 flex max-w-4xl flex-wrap items-start justify-center gap-6">
      {allMembers.map((member) => {
        const initials = member.name.split(' ').map((w) => w[0]).slice(0, 2).join('');
        return (
          <div class:list={['member-card', { 'has-bio': !!member.bio }]} tabindex={member.bio ? 0 : undefined}>
            <div class="member-photo-wrap">
              {member.image
                ? <img class="member-photo" src={member.image} alt={`Portrait of ${member.name}`} loading="lazy" />
                : <div class="member-photo member-photo--ph" aria-hidden="true">{initials}</div>}
            </div>
            <div class="member-info">
              <h3 class="member-name">{member.name}</h3>
              <p class="member-role">{member.role}</p>
            </div>
            {member.bio && (
              <div class="member-bio" role="tooltip">
                <p class="member-bio-name">{member.name}</p>
                <p class="member-bio-role">{member.role}</p>
                <hr class="member-bio-divider" />
                <p class="member-bio-text">{member.bio}</p>
                {member.studioUrl && (
                  <p class="member-bio-text member-bio-studio">
                    Learn more at{' '}
                    <a href={member.studioUrl} target="_blank" rel="noopener" class="member-bio-link">www.iconicstudioart.com</a>
                  </p>
                )}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- Get in touch -->
  <section class="bg-[var(--thp-muted)]">
    <div class="mx-auto max-w-5xl px-6 py-16 lg:py-20">
      <ContactForm
        heading="Get in Touch"
        intro="Have a question about our mission, or want to get involved? We’d love to hear from you."
        inquiryLabel="Your inquiry"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* About hero — a partial-height image banner (not the full-screen home hero).
     The Pantheon dome sits behind a soft cream veil so the dark title reads. */
  .about-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: var(--thp-muted);
  }
  .about-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }
  /* Light gradient on the left so the dark title + mission stay legible */
  .about-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(249, 245, 236, 0.55),
      rgba(249, 245, 236, 0.28) 52%,
      rgba(249, 245, 236, 0) 86%
    );
  }
  @media (max-width: 640px) {
    .about-hero-veil { background: rgba(249, 245, 236, 0.55); }
  }
  .about-hero-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .about-hero-content { max-width: 42rem; }
  .about-hero-title {
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.01em;
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    color: var(--thp-foreground);
  }
  .about-hero-kicker { margin-bottom: 1.25rem; }
  .about-hero-mission {
    margin-top: 1.5rem;
    max-width: 38ch;
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: 1.55;
    color: var(--thp-foreground);
  }

  /* What is Catholic Art — full-bleed painting behind a cream veil (mirrors home "Why It Matters") */
  .cathart-band {
    background-image: url('/images/about/philip-baptising-eunuch.jpg');
    background-size: cover;
    background-position: center 35%;
    background-repeat: no-repeat;
  }
  .cathart-overlay {
    position: relative;
    background: rgba(249, 245, 236, 0.78);
  }
  .cathart-credit {
    position: absolute;
    right: clamp(1rem, 4vw, 2.5rem);
    bottom: 0.7rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    color: var(--thp-muted-foreground);
  }

  /* ── Team member cards ─────────────────────────────────────────── */
  .member-card {
    position: relative;
    display: block;
    width: clamp(9rem, 42vw, 12rem);
    text-align: left;
    background: var(--thp-card);
    border: 1px solid var(--thp-border);
    border-radius: 8px;
    box-shadow: 0 10px 28px -20px rgba(15, 55, 82, 0.4);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .member-card.has-bio:hover,
  .member-card.has-bio:focus-within {
    box-shadow: 0 20px 44px -20px rgba(15, 55, 82, 0.5);
    transform: translateY(-2px);
    z-index: 20;
  }
  .member-card.has-bio:focus-visible {
    outline: 2px solid var(--thp-primary);
    outline-offset: 3px;
  }
  .member-photo-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
    background: var(--thp-muted);
  }
  .member-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .member-card.has-bio:hover .member-photo { transform: scale(1.03); }
  /* Placeholder tile (no headshot yet) — initials, no greyscale */
  .member-photo--ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--thp-muted-foreground);
    background: var(--thp-secondary);
    filter: none;
  }
  /* Reserve room for up to a two-line name + two-line role so every card
     is the same height regardless of how the text wraps. */
  .member-info { padding: 1rem 1.1rem 1.25rem; min-height: 8rem; }
  .member-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.2;
    color: var(--thp-foreground);
  }
  .member-role {
    margin-top: 0.3rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.35;
    /* reserve two lines so every card is exactly the same height */
    min-height: 2.7em;
    color: var(--thp-muted-foreground);
  }

  /* ── Bio popover — opens on hover/focus (light, matches the card) ── */
  .member-bio {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    width: 19rem;
    max-width: 86vw;
    transform: translateX(-50%) scale(0.97);
    transform-origin: top center;
    z-index: 40;
    background: rgba(255, 253, 247, 0.82);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--thp-foreground);
    border: 1px solid var(--thp-border);
    border-radius: 10px;
    padding: 1.25rem 1.5rem 1.4rem;
    box-shadow: 0 26px 60px -20px rgba(15, 55, 82, 0.45);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s ease;
  }
  .member-card:hover .member-bio,
  .member-card:focus-within .member-bio {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) scale(1);
  }
  .member-bio-name {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.1;
    color: var(--thp-primary);
  }
  .member-bio-role {
    margin-top: 0.25rem;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.66rem;
    color: var(--thp-gold);
  }
  .member-bio-divider {
    width: 2rem;
    height: 1px;
    margin: 0.85rem 0 0;
    border: 0;
    background: var(--thp-gold);
  }
  .member-bio-text {
    margin-top: 0.85rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--thp-muted-foreground);
  }
  .member-bio-studio { margin-top: 0.65rem; }
  .member-bio-link { color: var(--thp-primary); text-decoration: underline; text-underline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .member-photo, .member-card, .member-bio { transition: none; }
  }
</style>
