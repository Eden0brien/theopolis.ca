  .artist-listen { margin-top: 1.75rem; }

  /* ── Closing patronage block ── */
  .join-block { background: var(--thp-navy); }
</style>

<script>
  // Auto-scrolling testimonials carousel.
  const track = document.getElementById('tstm-track');
  if (track) {
    const slides = Array.from(track.querySelectorAll('.tstm-slide'));
    const dots = Array.from(document.querySelectorAll('#tstm-dots .tstm-dot'));
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer;

    const go = (i) => {
      current = (i + slides.length) % slides.length;
      track.style.transform = `translateX(-${current * 100}%)`;
      slides.forEach((s, n) => s.setAttribute('aria-hidden', n === current ? 'false' : 'true'));
      dots.forEach((d, n) => {
        d.classList.toggle('is-active', n === current);
        d.setAttribute('aria-selected', n === current ? 'true' : 'false');
      });
    };

    const start = () => {
      if (prefersReduced || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => go(current + 1), 6000);
    };
    const stop = () => { if (timer) window.clearInterval(timer); };

    track.style.transition = 'transform 0.7s cubic-bezier(0.22, 1, 0.36, 1)';
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { go(i); start(); });
    });

    // Pause on hover / focus so readers aren't rushed.
    const section = track.closest('.tstm');
    section?.addEventListener('mouseenter', stop);
    section?.addEventListener('mouseleave', start);
    section?.addEventListener('focusin', stop);
    section?.addEventListener('focusout', start);

    go(0);
    start();
  }
</script>
