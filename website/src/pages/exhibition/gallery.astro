---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const artworks = (await getCollection('artworks')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);

const SUPPORT = '/support';
---
<BaseLayout
  title="Buy 2026 Exhibition Art"
  description="Original works from The Drama of the Soul exhibition. 100% of every sale goes directly to the artist."
  fullWidth
>
  <PageHero
    eyebrow="The Drama of the Soul"
    title="Buy 2026 Exhibition Art"
    lead="100% of every sale goes directly to the artist."
  />

  <section class="mx-auto max-w-6xl px-6 py-14">
    <div class="gap-6 [column-fill:_balance] columns-1 sm:columns-2 lg:columns-3">
      {artworks.map((art) => {
        const { title, artist, price, status, buyUrl, image } = art.data;
        return (
          <article class="mb-6 break-inside-avoid overflow-hidden rounded-xl border border-[var(--thp-border)] bg-[var(--thp-card)] shadow-sm">
            <div class="relative">
              {image && (
                <img src={image} alt={`${title} by ${artist}`} loading="lazy" decoding="async"
                  class="w-full bg-[var(--thp-muted)]" />
              )}
              {status === 'sold' && (
                <span class="absolute right-3 top-3 rounded-full bg-[var(--thp-foreground)]/85 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">Sold</span>
              )}
              {status === 'nfs' && (
                <span class="absolute right-3 top-3 rounded-full bg-[var(--thp-gold)] px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">Not for sale</span>
              )}
            </div>
            <div class="p-5">
              <h2 class="text-2xl font-semibold leading-tight text-[var(--thp-foreground)]">{title}</h2>
              <p class="mt-1 text-[var(--thp-gold)]">{artist}</p>
              <div class="mt-4 flex items-center justify-between gap-3">
                <span class="text-lg font-semibold text-[var(--thp-primary)]">{price}</span>
                {status === 'available' && buyUrl && (
                  <a href={buyUrl} target="_blank" rel="noopener" class="btn btn-primary !px-5 !py-2 !text-base">Buy Now</a>
                )}
                {status === 'available' && !buyUrl && (
                  <a href={SUPPORT} class="btn btn-outline !px-5 !py-2 !text-base">Enquire</a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
