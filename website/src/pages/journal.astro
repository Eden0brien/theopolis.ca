---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const posts = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout
  title="The Tempest"
  description="The Tempest is Theopolis’ quarterly journal of arts and letters — a serious publication for the Catholic literary arts in Canada."
  fullWidth
>
  <PageHero
    eyebrow="The Tempest"
    title="A Journal of Arts & Letters"
    lead="The Tempest is a quarterly journal created to document the development and results of Theopolis, and to serve as a serious publication for the Catholic literary arts in Canada."
  />

  <section class="mx-auto max-w-3xl px-6 py-20">
    {posts.length === 0 ? (
      <div class="rounded-xl border border-dashed border-[var(--thp-border)] bg-[var(--thp-card)] px-6 py-16 text-center">
        <p class="text-2xl font-semibold text-[var(--thp-primary)]">Check back soon</p>
        <p class="mx-auto mt-3 max-w-md text-[var(--thp-muted-foreground)]">
          The first issue of The Tempest is in preparation. Subscribe to our updates through the
          contact form to be notified when it’s published.
        </p>
        <a href="/support" class="btn btn-outline mt-6">Get in touch</a>
      </div>
    ) : (
      <div class="space-y-10">
        {posts.map((post) => (
          <article class="border-b border-[var(--thp-border)] pb-8">
            <h2 class="text-3xl font-semibold text-[var(--thp-primary)]">{post.data.title}</h2>
            <p class="mt-1 text-sm text-[var(--thp-gold)]">
              {post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' })}
              {post.data.author && <> &middot; {post.data.author}</>}
            </p>
            {post.data.summary && <p class="mt-3 leading-relaxed text-[var(--thp-muted-foreground)]">{post.data.summary}</p>}
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
