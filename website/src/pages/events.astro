---
import BaseLayout from '../layouts/BaseLayout.astro';

const GAUDI_HREF = '/gaudi-lecture';

// 2 — Upcoming events (chronological). Posters forthcoming.
const upcomingEvents = [
  {
    date: 'August 6, 2026',
    time: '9:30 AM – 3:00 PM',
    title: 'Your Artistic Vocation as Builder of the Common Good',
    subtitle: 'A workshop on Catholic Social Teaching & the artistic vocation, with Brendan Steven',
    location: 'Cardus Ottawa (45 Rideau St) + the National Gallery of Canada',
    cost: '$45',
    description:
      'Brendan Steven leads an exploration of the artistic vocation as an act of public service — drawing on Catholic social teaching, from Gaudium et Spes to John Paul II’s Letter to Artists, to ask why beautiful, truthful art is irreplaceable to the common good.',
  },
  {
    date: 'August 28–30, 2026',
    title: 'Artists’ Retreat at Martyrs’ Shrine',
    location: 'Martyrs’ Shrine, 16163 Highway 12 West, Midland, Ontario',
    description:
      'A weekend retreat for artists — a time of prayer, rest, fraternity, and vocational renewal for those seeking to deepen the relationship between their creative work, spiritual life, and mission.',
  },
  {
    date: 'October 24, 2026',
    tag: 'Inaugural Annual Lecture',
    title: 'The Gaudí Lecture',
    subtitle: 'Featuring Jonathan Pageau',
    location: 'Victoria College, University of Toronto',
    description:
      'Our inaugural Annual Lecture — a public defence of the Christian imagination and its role in shaping culture, delivered by renowned liturgical artist and writer Jonathan Pageau, followed by an audience Q&A and reception.',
    href: '/gaudi-lecture',
    hrefLabel: 'Learn more',
  },
];

// 1 — Our programs (the recurring shape of Theopolis events)
const programs = [
  {
    title: 'Annual Lecture Series',
    image: '/images/events/program-lecture.jpg',
    body: 'Each year our lecture series invites distinguished creative figures to reflect on the role of the Catholic imagination in a world where it is increasingly rare, yet more vital than ever.',
  },
  {
    title: 'Exhibition',
    image: '/images/events/program-exhibition.jpg',
    body: 'Our annual exhibition showcases the creative activity of our members and opens a space of encounter between secular and Christian audiences, engaging themes at the heart of contemporary Canadian culture through art.',
    cta: { label: 'Explore the archive', href: '/exhibition' },
  },
  {
    title: 'Quarterly Socials',
    image: '/images/events/program-socials.jpg',
    body: 'Our quarterly socials welcome artists and all those who love art and the Catholic tradition — an invitation to conversation, collaboration, and fellowship in a vibrant community.',
  },
];

// 3 — Past events (details read from the printed posters)
const pastEvents = [
  {
    title: 'The Drama of the Soul',
    subtitle: 'An exhibition presented by Theopolis',
    date: 'May 2–3, 9–10 & 16–17, 2026',
    location: '183 Queen St E, Toronto',
    description:
      'Our inaugural exhibition — a group show of Catholic art exploring the existence, nature, and problems of the Soul, across three weekends in downtown Toronto.',
    poster: '/images/events/drama-of-the-soul-poster.jpg',
    href: '/exhibition',
    hrefLabel: 'Explore the archive',
  },
  {
    title: 'Pop-Up Shop at Kensington Market',
    subtitle: 'An evening of art, music, drinks & community',
    date: 'Friday, June 19, 2026 · 6–10 PM',
    location: 'The Arch Café/Bar, 293 Augusta Ave, Toronto',
    description:
      'An evening in Kensington Market to meet our artists, connect with fellow culture-lovers, and shop special-edition prints from The Drama of the Soul exhibition.',
    poster: '/images/events/pop-up-shop-poster.jpg',
  },
  {
    title: 'On the Road to Dante',
    subtitle: 'Timothy Schmalz & the Artist’s Journey — a lecture & sculpture walking tour',
    date: 'July 11, 2026 · 5–7:30 PM',
    location: 'Regis College, University of Toronto',
    description:
      'A lecture and outdoor sculpture walking tour with Canadian sculptor Timothy Schmalz, following the artist’s journey through Dante’s Divine Comedy.',
    poster: '/images/events/on-the-road-to-dante-poster.jpg',
  },
];
---
<BaseLayout
  title="Events"
  description="Lectures, exhibitions, and quarterly socials from Theopolis — gathering Catholic artists and culture-lovers across Ontario."
  fullWidth
>
  <!-- Hero banner — looping recap video of past events (image poster as fallback) -->
  <section class="ev-hero">
    <video
      class="ev-hero-img"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/videos/event-banner-poster.jpg"
      aria-hidden="true"
    >
      <source src="/videos/event-banner.mp4" type="video/mp4" />
    </video>
    <div class="ev-hero-veil"></div>
    <div class="ev-hero-inner mx-auto max-w-6xl px-6">
      <div class="ev-hero-content">
        <p class="label section-kicker ev-hero-kicker">Events</p>
        <h1 class="ev-hero-title">Gatherings &amp; Programs</h1>
        <p class="ev-hero-lead">
          Lectures, exhibitions, and quarterly socials &mdash; gathering Catholic artists and all
          who love art and the Catholic tradition.
        </p>
      </div>
    </div>
  </section>

  <!-- ── 1 · Our programs ─────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-6 pt-16 lg:pt-20 pb-6">
    <p class="label section-kicker">Our Programs</p>
    <hr class="rule mt-4" />
    <div class="prog-grid">
      {programs.map((p, i) => (
        <div class="prog-card" tabindex="0" aria-label={p.title}>
          <div class="prog-inner">
            <div class="prog-front">
              <img src={p.image} alt={p.title} loading="lazy" decoding="async" />
              <div class="prog-front-overlay">
                <span class="prog-num prog-num--light">{String(i + 1).padStart(2, '0')}</span>
                <h2 class="prog-title prog-title--light">{p.title}</h2>
              </div>
            </div>
            <div class="prog-back">
              <span class="prog-num prog-num--light">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="prog-back-title">{p.title}</h2>
              <p class="prog-back-body">{p.body}</p>
              {p.cta && (
                <a href={p.cta.href} class="link-arrow on-dark prog-back-link">{p.cta.label} <span>&rarr;</span></a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── 2 · Upcoming events ──────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-6 py-10">
    <p class="label section-kicker">Upcoming Events</p>
    <hr class="rule mt-4" />
    <div class="up-list">
      {upcomingEvents.map((e) => (
        <article class="up-event">
          <div class="up-when">
            <p class="up-date">{e.date}</p>
            {e.time && <p class="up-time">{e.time}</p>}
          </div>
          <div class="up-body">
            {e.tag && <p class="up-tag">{e.tag}</p>}
            <h3 class="up-title">{e.title}</h3>
            {e.subtitle && <p class="up-subtitle">{e.subtitle}</p>}
            <p class="up-loc">{e.location}{e.cost ? ` · ${e.cost}` : ''}</p>
            <p class="up-desc">{e.description}</p>
            {e.href && (
              <a href={e.href} class="link-arrow up-cta">{e.hrefLabel ?? 'Learn more'} <span>&rarr;</span></a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── 3 · Past events ──────────────────────────────────────── -->
  <section class="mx-auto max-w-6xl px-6 pt-10 pb-20 lg:pb-24">
    <p class="label section-kicker">Past Events</p>
    <hr class="rule mt-4" />
    <div class="mt-12 flex flex-col gap-16">
      {pastEvents.map((e) => (
        <article class="past-event">
          <div class="past-poster">
            <img src={e.poster} alt={`${e.title} — event poster`} loading="lazy" decoding="async" />
          </div>
          <div class="past-info">
            <h3 class="past-title">{e.title}</h3>
            {e.subtitle && <p class="past-subtitle">{e.subtitle}</p>}
            <ul class="past-meta">
              <li>{e.date}</li>
              <li>{e.location}</li>
            </ul>
            <p class="past-desc">{e.description}</p>
            {e.href && (
              <a href={e.href} class="link-arrow past-link">{e.hrefLabel ?? 'Learn more'} <span>&rarr;</span></a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Events hero — full-screen artwork banner, same treatment as the About page. */
  .ev-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: var(--thp-muted);
  }
  .ev-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }
  .ev-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(249, 245, 236, 0.88),
      rgba(249, 245, 236, 0.5) 50%,
      rgba(249, 245, 236, 0.05) 86%
    );
  }
  @media (max-width: 640px) {
    .ev-hero-veil { background: rgba(249, 245, 236, 0.8); }
  }
  .ev-hero-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .ev-hero-content { max-width: 42rem; }
  .ev-hero-kicker { margin-bottom: 1.25rem; }
  .ev-hero-title {
    font-family: var(--font-sans);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.01em;
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    color: var(--thp-foreground);
  }
  .ev-hero-lead {
    margin-top: 1.5rem;
    max-width: 38ch;
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: 1.55;
    color: var(--thp-foreground);
  }
  .ev-hero-credit {
    position: absolute;
    right: clamp(1rem, 4vw, 2.5rem);
    bottom: 0.7rem;
    z-index: 3;
    font-family: var(--font-body);
    font-size: 0.58rem;
    letter-spacing: 0.02em;
    color: var(--thp-muted-foreground);
  }

  /* 1 · Programs — hover-to-flip cards */
  .prog-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }
  @media (min-width: 640px) {
    .prog-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .prog-card { perspective: 1400px; cursor: pointer; }
  .prog-card:focus-visible { outline: 2px solid var(--thp-primary); outline-offset: 4px; border-radius: 12px; }
  .prog-inner {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .prog-card:hover .prog-inner,
  .prog-card:focus .prog-inner,
  .prog-card:focus-within .prog-inner { transform: rotateY(180deg); }
  .prog-front,
  .prog-back {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    overflow: hidden;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    box-shadow: 0 16px 38px -20px rgba(15, 55, 82, 0.5);
  }
  .prog-front img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .prog-front-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(15, 55, 82, 0.85), rgba(15, 55, 82, 0.1) 55%, transparent);
  }
  .prog-back {
    transform: rotateY(180deg);
    background: var(--thp-navy);
    color: #f9f4e9;
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .prog-num {
    font-family: var(--font-body);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    color: var(--thp-gold);
  }
  .prog-num--light { color: var(--thp-marigold); }
  .prog-title {
    margin-top: 0.4rem;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    line-height: 1.1;
    color: var(--thp-foreground);
  }
  .prog-title--light { color: #f9f4e9; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35); }
  .prog-back-title {
    margin-top: 0.4rem;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.7rem);
    line-height: 1.1;
    color: #f9f4e9;
  }
  .prog-back-body {
    margin-top: 0.85rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(249, 244, 233, 0.86);
  }
  .prog-back-link { margin-top: 1.1rem; align-self: flex-start; }
  @media (prefers-reduced-motion: reduce) {
    .prog-inner { transition: none; }
  }

  /* 2 · Upcoming — a dated list */
  .up-list { margin-top: 2.5rem; }
  .up-event {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 2.5rem;
    padding: 2.25rem 0;
    border-top: 1px solid var(--thp-border);
  }
  .up-event:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 768px) {
    .up-event { grid-template-columns: 13rem 1fr; }
  }
  .up-date {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    line-height: 1.15;
    color: var(--thp-gold);
  }
  .up-time {
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--thp-muted-foreground);
  }
  .up-tag {
    display: inline-block;
    margin-bottom: 0.65rem;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--thp-primary);
  }
  .up-title {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
    color: var(--thp-foreground);
  }
  .up-subtitle {
    margin-top: 0.4rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--thp-primary);
  }
  .up-loc {
    margin-top: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--thp-muted-foreground);
  }
  .up-desc {
    margin-top: 0.75rem;
    max-width: 62ch;
    font-family: var(--font-body);
    line-height: 1.65;
    color: var(--thp-muted-foreground);
  }
  .up-cta { margin-top: 1rem; font-size: 0.95rem; }

  /* 3 · Past events — poster beside details */
  .past-event {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.75rem;
    align-items: start;
  }
  @media (min-width: 720px) {
    .past-event { grid-template-columns: 240px 1fr; }
  }
  .past-poster img {
    width: 100%;
    display: block;
    border-radius: 8px;
    box-shadow: 0 18px 40px -20px rgba(15, 55, 82, 0.55);
  }
  .past-title {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.08;
    color: var(--thp-foreground);
  }
  .past-subtitle {
    margin-top: 0.45rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--thp-primary);
  }
  .past-meta {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--thp-muted-foreground);
  }
  .past-meta li + li { margin-top: 0.15rem; }
  .past-desc {
    margin-top: 1rem;
    max-width: 60ch;
    font-family: var(--font-body);
    line-height: 1.7;
    color: var(--thp-muted-foreground);
  }
  .past-link { margin-top: 1.1rem; font-size: 0.95rem; }
</style>
