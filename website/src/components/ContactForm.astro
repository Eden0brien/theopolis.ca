---
// Contact / "Get in Touch" form, used on Home, About, Support, and Contact.
//
// Static sites can't run Wix Forms, so this submits to Formspree (a free
// form-backend service) — it forwards submissions straight to
// founder@theopolis.ca. Submitted via fetch() so the visitor stays on the
// page and sees an inline thank-you instead of redirecting to Formspree.
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mjybbboa';

interface Props {
  heading?: string;
  intro?: string;
  /** Label for the free-text context field. */
  inquiryLabel?: string;
}
const {
  heading = 'Get in Touch',
  intro,
  inquiryLabel = 'How can we help?',
} = Astro.props;
---
<div class="mx-auto max-w-2xl">
  {heading && <h2 class="text-3xl font-semibold text-[var(--thp-primary)] text-center">{heading}</h2>}
  {intro && <p class="mt-3 text-center text-[var(--thp-muted-foreground)] leading-relaxed">{intro}</p>}

  <form class="contact-form mt-8 grid gap-5" data-contact-form action={FORMSPREE_ENDPOINT} method="POST">
    <div class="grid gap-5 sm:grid-cols-2">
      <label class="field">
        <span>First name <em>*</em></span>
        <input type="text" name="first_name" required autocomplete="given-name" />
      </label>
      <label class="field">
        <span>Last name <em>*</em></span>
        <input type="text" name="last_name" required autocomplete="family-name" />
      </label>
    </div>
    <label class="field">
      <span>Email <em>*</em></span>
      <input type="email" name="email" required autocomplete="email" />
    </label>
    <label class="field">
      <span>{inquiryLabel}</span>
      <textarea name="inquiry" rows="4"></textarea>
    </label>
    <div class="text-center">
      <button type="submit" class="btn btn-primary">Submit</button>
      <p class="contact-form-status" data-form-status role="status" aria-live="polite"></p>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll('[data-contact-form]').forEach((form) => {
    const status = form.querySelector('[data-form-status]');
    const button = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      button.disabled = true;
      status.textContent = 'Sending…';
      status.classList.remove('is-error');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          status.textContent = 'Thanks — your message has been sent. We’ll be in touch soon.';
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        status.textContent =
          'Something went wrong sending that. Please try again, or email us directly at founder@theopolis.ca.';
        status.classList.add('is-error');
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .field > span {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--thp-foreground);
  }
  .field em { color: var(--thp-primary); font-style: normal; }
  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--thp-foreground);
    background: var(--thp-card);
    border: 1px solid var(--thp-border);
    border-radius: 0.6rem;
    padding: 0.7rem 0.85rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .field textarea { resize: vertical; }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--thp-primary);
    box-shadow: 0 0 0 3px rgba(60, 94, 115, 0.15);
  }
  .contact-form-status {
    margin-top: 0.85rem;
    min-height: 1.2em;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--thp-primary);
  }
  .contact-form-status.is-error { color: #b3413a; }
</style>
