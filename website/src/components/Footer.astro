---
const FOUNDED_YEAR = 2025;
const currentYear = new Date().getFullYear();
const rightsRange = currentYear > FOUNDED_YEAR ? `${FOUNDED_YEAR}–${currentYear}` : `${FOUNDED_YEAR}`;

const links = [
  { href: '/about', label: 'About' },
  { href: '/support', label: 'Support' },
  { href: '/journal', label: 'The Tempest' },
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/accessibility', label: 'Accessibility' },
];
---

<footer class="mt-16">
  <div class="bg-[var(--thp-primary)] text-white">
    <div class="mx-auto max-w-6xl px-8 py-10">
      <div class="flex flex-wrap items-start justify-between gap-8">

        <!-- Brand + tagline -->
        <div class="max-w-sm">
          <a href="/" class="font-[family-name:var(--font-sans)] text-2xl font-semibold tracking-wide text-white no-underline">
            Theopolis
          </a>
          <p class="mt-2 text-white/80 leading-relaxed">
            Empowering Catholic Artists. Renewing Faith &amp; Culture.
          </p>
          <p class="mt-3 text-sm text-white/60">Toronto, Canada</p>
        </div>

        <!-- Links -->
        <nav aria-label="Footer" class="flex flex-col gap-2">
          {links.map((l) => (
            <a href={l.href} class="text-white/85 hover:text-white transition-colors no-underline">{l.label}</a>
          ))}
        </nav>
      </div>

      <hr class="my-8 border-white/15" />

      <p class="text-sm text-white/60">© {rightsRange} Theopolis. All rights reserved.</p>
    </div>
  </div>
</footer>
